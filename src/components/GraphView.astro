---
interface GraphNode {
	id: string;
	title: string;
	type: string;
	current: boolean;
}
interface GraphEdge {
	source: string;
	target: string;
}
interface Props {
	graphData: {
		nodes: GraphNode[];
		edges: GraphEdge[];
	};
}
const { graphData } = Astro.props;
---

<div class="graph-container" data-graph={JSON.stringify(graphData)}>
	<svg></svg>
</div>

<script>
	import { forceSimulation, forceLink, forceManyBody, forceCenter, forceCollide } from 'd3-force';
	import { select } from 'd3-selection';
	import { zoom } from 'd3-zoom';
	import { drag } from 'd3-drag';

	function initGraph(container: HTMLElement) {
		const raw = JSON.parse(container.dataset.graph!);
		const svg = select(container.querySelector('svg')!);
		const width = container.clientWidth;
		const height = 400;

		svg.attr('width', width).attr('height', height).attr('viewBox', `0 0 ${width} ${height}`);

		// Deep copy nodes/edges so D3 can mutate them
		const nodes = raw.nodes.map((n: any) => ({ ...n }));
		const edges = raw.edges.map((e: any) => ({ ...e }));

		// Color
		const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
		const gray = 'rgb(' + getComputedStyle(document.documentElement).getPropertyValue('--gray').trim() + ')';
		const textColor = 'rgb(' + getComputedStyle(document.documentElement).getPropertyValue('--gray-dark').trim() + ')';

		svg.selectAll('*').remove();
		const g = svg.append('g');

		// Zoom
		const zoomBehavior = zoom<SVGSVGElement, unknown>()
			.scaleExtent([0.3, 3])
			.on('zoom', (event) => g.attr('transform', event.transform));
		svg.call(zoomBehavior as any);

		// Links
		const link = g.append('g')
			.selectAll('line')
			.data(edges)
			.join('line')
			.attr('stroke', gray)
			.attr('stroke-opacity', 0.4)
			.attr('stroke-width', 1.5);

		// Nodes
		const node = g.append('g')
			.selectAll('g')
			.data(nodes)
			.join('g')
			.attr('cursor', 'pointer')
			.on('click', (_event: any, d: any) => {
				window.location.href = `/concepts/${d.id}/`;
			});

		node.append('circle')
			.attr('r', (d: any) => d.current ? 12 : 8)
			.attr('fill', (d: any) => d.current ? accent : gray)
			.attr('fill-opacity', (d: any) => d.current ? 1 : 0.6)
			.attr('stroke', (d: any) => d.current ? accent : 'none')
			.attr('stroke-width', (d: any) => d.current ? 2 : 0);

		node.append('text')
			.text((d: any) => d.title.length > 12 ? d.title.slice(0, 12) + '…' : d.title)
			.attr('font-size', (d: any) => d.current ? '13px' : '11px')
			.attr('font-weight', (d: any) => d.current ? '700' : '400')
			.attr('font-family', 'var(--font-ui), sans-serif')
			.attr('fill', textColor)
			.attr('text-anchor', 'middle')
			.attr('dy', (d: any) => d.current ? -18 : -14);

		// Hover highlight
		node.on('mouseenter', function (_event: any, d: any) {
			link.attr('stroke-opacity', (l: any) =>
				(l.source.id || l.source) === d.id || (l.target.id || l.target) === d.id ? 0.9 : 0.1
			).attr('stroke-width', (l: any) =>
				(l.source.id || l.source) === d.id || (l.target.id || l.target) === d.id ? 2.5 : 1
			);
		}).on('mouseleave', function () {
			link.attr('stroke-opacity', 0.4).attr('stroke-width', 1.5);
		});

		// Drag
		const dragBehavior = drag<SVGGElement, any>()
			.on('start', (event, d) => {
				if (!event.active) sim.alphaTarget(0.3).restart();
				d.fx = d.x;
				d.fy = d.y;
			})
			.on('drag', (event, d) => {
				d.fx = event.x;
				d.fy = event.y;
			})
			.on('end', (event, d) => {
				if (!event.active) sim.alphaTarget(0);
				d.fx = null;
				d.fy = null;
			});
		node.call(dragBehavior as any);

		// Simulation
		const sim = forceSimulation(nodes as any)
			.force('link', forceLink(edges).id((d: any) => d.id).distance(100))
			.force('charge', forceManyBody().strength(-300))
			.force('center', forceCenter(width / 2, height / 2))
			.force('collide', forceCollide(30))
			.on('tick', () => {
				link
					.attr('x1', (d: any) => d.source.x)
					.attr('y1', (d: any) => d.source.y)
					.attr('x2', (d: any) => d.target.x)
					.attr('y2', (d: any) => d.target.y);
				node.attr('transform', (d: any) => `translate(${d.x},${d.y})`);
			});
	}

	// Initialize on load and on Astro page transitions
	function init() {
		document.querySelectorAll<HTMLElement>('.graph-container').forEach(initGraph);
	}
	init();
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.graph-container {
		width: 100%;
		height: 400px;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		overflow: hidden;
		background: rgba(var(--gray-light), 0.15);
	}
	.graph-container svg {
		width: 100%;
		height: 100%;
	}
</style>
